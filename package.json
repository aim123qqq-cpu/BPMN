{
  "name": "bpmn-agent",
  "version": "0.1.0",
  "description": "AI-агент системного аналитика (MCP-сервер, skill, CLI): бизнес-процессы из документации → BPMN для stormBPMN, Camunda 7/8, draw.io",
  "type": "module",
  "bin": {
    "bpmn-agent": "src/cli.mjs",
    "bpmn-agent-mcp": "src/mcp/server.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node src/cli.mjs build samples/models --docs samples/docs --formats generic,camunda7,camunda8,drawio --out out/demo",
    "prompt": "node src/cli.mjs prompt",
    "mcp": "node src/mcp/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "bpmn-js": "18.31.0",
    "bpmn-moddle": "10.3.1",
    "bpmnlint": "11.14.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aim123qqq-cpu/BPMN.git"
  }
}
